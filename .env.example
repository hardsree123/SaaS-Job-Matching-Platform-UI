# Telegram Instant Lead Notification Bot (Recommended)
# 1. Create a bot with @BotFather on Telegram to get your token.
# 2. Get your Chat ID from @userinfobot or @GetIDsBot on Telegram.
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=

# Optional: Webhook URL (e.g. Make.com, Zapier, Twilio, or backend API)
VITE_LEAD_WEBHOOK_URL=
