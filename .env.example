# ==============================================================================
# DibsMatch SaaS - Production Server Environment Variables (Vercel / Backend)
# Add these variables to your Vercel Project Dashboard (Settings -> Environment Variables).
# Notice: No VITE_ prefix. These variables run purely on the server and are NEVER exposed to the browser.
# ==============================================================================

# Telegram Bot Credentials (Server-Side Only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Webhook URL (Server-Side Only)
LEAD_WEBHOOK_URL=
